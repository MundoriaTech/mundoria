record = zoho.recruit.getRecordById("Candidates",candidateId.toLong());
if(record.get("CANDIDATEID") == null)
{
	info "Checklist read failed. Error code: " + ifnull(record.get("code"),"unknown").toString();
	return;
}
if(ifnull(record.get("Recruit Automation Enabled"),false).toString() != "true" && ifnull(record.get("Internal Test"),false).toString() != "true")
{
	info "Checklist skipped: automation is not enabled for this record.";
	return;
}
documents = Map();
documents.put("Government ID Status","Government ID");
documents.put("Right to Work Status","Right to Work evidence");
documents.put("UTR Status","UTR evidence");
documents.put("DBS Status","DBS certificate");
documents.put("Insurance Status","Public liability insurance");
documents.put("Proof of Address Status","Proof of address");
documents.put("Photograph Status","Profile photograph");
if(ifnull(record.get("Other Documents Required"),false).toString() == "true")
{
	documents.put("Other Documents Status","Additional required documents");
}
missing = List();
awaiting = 0;
for each field in documents.keys()
{
	status = ifnull(record.get(field),"Not Uploaded");
	if(field == "Insurance Status" && ifnull(record.get("Insurance Expiry"),"").toString() != "")
	{
		if(record.get("Insurance Expiry").toString().toDate() < zoho.currentdate)
		{
			status = "Expired";
		}
	}
	if(status == "Uploaded" || status == "Under Review")
	{
		awaiting = awaiting + 1;
	}
	else if(status != "Approved")
	{
		missing.add(documents.get(field));
	}
}
missingText = missing.toString(", ");
if(ifnull(record.get("Outstanding Document Count"),-1).toString() == missing.size().toString() && ifnull(record.get("Documents Awaiting Approval"),-1).toString() == awaiting.toString() && ifnull(record.get("Outstanding Documents"),"") == missingText)
{
	info "Checklist already current; no update needed.";
	return;
}
updates = Map();
updates.put("Outstanding Document Count",missing.size());
updates.put("Documents Awaiting Approval",awaiting);
updates.put("Outstanding Documents",missingText);
result = zoho.recruit.updateRecord("Candidates",candidateId.toLong(),updates,false);
verified = zoho.recruit.getRecordById("Candidates",candidateId.toLong());
if(verified.get("CANDIDATEID") != null && ifnull(verified.get("Outstanding Document Count"),-1).toString() == missing.size().toString() && ifnull(verified.get("Documents Awaiting Approval"),-1).toString() == awaiting.toString() && ifnull(verified.get("Outstanding Documents"),"") == missingText)
{
	info "Checklist saved and verified; document approvals and activation were not changed.";
}
else
{
	info "Checklist update could not be verified. Update code: " + ifnull(result.get("code"),"unknown").toString();
}
