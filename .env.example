# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Platform destination (Your account) signing secret.
STRIPE_WEBHOOK_SECRET=
# Connected-accounts destination signing secret (if different from above).
STRIPE_WEBHOOK_SECRET_CONNECT=
NEXT_PUBLIC_GEOAPIFY_API_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Same app id exposed to the browser for Web Push enroll (optional).
NEXT_PUBLIC_ONESIGNAL_APP_ID=
# Zoho One. See docs/zoho-website-preview.md for branch-specific Vercel setup.
# Public embed URL from the SalesIQ website installation script's src attribute.
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_SRC=
# Server-only. Use one fresh Mundoria-controlled inbox for synthetic Preview tests.
ZOHO_PREVIEW_TEST_EMAIL=
# Zoho CRM - server-only. Syncs customers to Contacts and cleaners to Leads.
# Create a self-client in the Zoho API Console for the account with scopes:
# ZohoCRM.modules.contacts.CREATE,ZohoCRM.modules.contacts.UPDATE,
# ZohoCRM.modules.leads.CREATE,ZohoCRM.modules.leads.UPDATE
# Generate a refresh token, then set these. Sync is skipped when unset.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Explicit endpoints for Mundoria's .com organisation.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
# Website callbacks become Sales leads whenever the CRM credentials are set
# (needs migration 20261121143000_zoho_sales_intake.sql). Rule id: "Mundoria -
# Sales enquiry intake" (7681667000000819040); empty = lead goes to the API
# user without routing. Key field defaults to Mundoria_Prospect_ID.
ZOHO_CRM_SALES_ASSIGNMENT_RULE_ID=
ZOHO_CRM_ENQUIRY_KEY_FIELD=
# Zoho Recruit - server-only. Syncs cleaner applicants to Candidates.
# Use a refresh token with Recruit scopes (do not reuse the CRM token):
# ZohoRecruit.modules.candidates.CREATE,ZohoRecruit.modules.candidates.UPDATE
# Sync is skipped when unset. See docs/zoho-recruit.md.
ZOHO_RECRUIT_CLIENT_ID=
ZOHO_RECRUIT_CLIENT_SECRET=
ZOHO_RECRUIT_REFRESH_TOKEN=
ZOHO_RECRUIT_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_RECRUIT_API_DOMAIN=https://recruit.zoho.com
# Zoho CPaaS Bookings agent. The new template sends are restricted to Preview.
ZOHO_CPAAS_EMAIL_API_KEY=
ZOHO_CPAAS_BOOKING_REQUEST_TEMPLATE_KEY=
ZOHO_CPAAS_CLEANER_CONFIRMED_TEMPLATE_KEY=
# International number, digits only, used by the public WhatsApp button.
NEXT_PUBLIC_WHATSAPP_NUMBER=447490228111
# Server-only. Places API key for the live Mundoria Google reviews badge.
GOOGLE_PLACES_API_KEY=
# Recommended. The Google Place ID of Mundoria's own verified listing. When empty, the
# site searches for "Mundoria Uk, 32 High Street, Bromsgrove" and only accepts a result
# whose name contains "Mundoria"; otherwise no Google rating is shown.
GOOGLE_PLACE_ID=
# Company details for the footer, terms, About page and Organization schema.
# Anything left empty is simply not published (no placeholders are ever shown).
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Mundoria UK
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_REGISTERED_OFFICE_STREET=
NEXT_PUBLIC_REGISTERED_OFFICE_LOCALITY=
NEXT_PUBLIC_REGISTERED_OFFICE_POSTCODE=
# Optional Mag social + newsletter (defaults to mundoriauk profiles if unset).
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mundoriauk
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/mundoriauk
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@mundoriauk
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/mundoriauk
# Optional POST endpoint for Mag newsletter subscribe JSON { email, source }.
RESEND_API_KEY=
# Verified Resend domain sender for all Mundoria transactional mail
RESEND_FROM_EMAIL=Mundoria <hello@mundoria.co.uk>
# Shown in email footers / reply-to (use the same domain)
SUPPORT_EMAIL=hello@mundoria.co.uk
# Ops alerts (new signups, cleaner applications). Falls back to SUPPORT_EMAIL if empty.
ADMIN_NOTIFICATION_EMAIL=
CRON_SECRET=
# Commercial office hourly rate in pence (default 3500 = £35/hr) until rates are final.
COMMERCIAL_HOURLY_RATE_PENCE=3500
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Lead automation (docs/lead-automation-playbook.md) ---------------------
# Master switch. Leave false until the services below are set up and tested.
OUTREACH_ENABLED=false
# Claude (Anthropic) writes replies and the weekly report.
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5).
OUTREACH_AI_MODEL=
# auto = the AI answers routine replies itself; review = every AI reply waits for approval.
OUTREACH_AI_REPLY_MODE=auto
# Marketing sender on its own subdomain, verified in Resend.
OUTREACH_EMAIL_FROM=Mundoria <hello@news.mundoria.co.uk>
# Reply-to on follow-ups: a Resend inbound address so the AI sees replies.
OUTREACH_REPLY_TO=
# Resend webhook signing secret (whsec_...) for /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=
# Sender for follow-up texts: a UK number or approved alphanumeric ID. Falls back to TWILIO_PHONE_NUMBER.
OUTREACH_SMS_FROM=
# On-call phone that gets an instant text for each callback request (e.g. +447700900123).
OUTREACH_ONCALL_PHONE=
# Extra comma-separated addresses for the weekly report (admins always get it).
OUTREACH_REPORT_EMAILS=
# Vapi AI calls: private API key, saved assistant id, saved phone number id, webhook bearer token.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
# Optional limits (defaults shown).
OUTREACH_SEND_FROM_HOUR=8
OUTREACH_SEND_UNTIL_HOUR=20
OUTREACH_WEEKLY_LIMIT=6
OUTREACH_MAX_CALLS=2

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Canonical site URL for SEO (sitemap, Open Graph, robots). Use www - apex redirects there.
NEXT_PUBLIC_APP_URL=https://www.mundoria.co.uk
EMAIL_ASSET_BASE_URL=
# Analytics. GTM-WB99DT5R is hard-coded and installed in app/layout.tsx
# (head script + body noscript). Consent Mode defaults deny storage until the banner.
NEXT_PUBLIC_GTM_ID=GTM-WB99DT5R
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional overrides; defaults are hard-coded in lib/analytics/gtm.ts.
# Clarity loads after Statistics consent; Meta Pixel after Marketing consent.
NEXT_PUBLIC_CLARITY_ID=zbn9ebygji
NEXT_PUBLIC_META_PIXEL_ID=1163478959669457
