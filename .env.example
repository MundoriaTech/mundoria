# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Platform destination (Your account) signing secret.
STRIPE_WEBHOOK_SECRET=
# Connected-accounts destination signing secret (if different from above).
STRIPE_WEBHOOK_SECRET_CONNECT=
NEXT_PUBLIC_GEOAPIFY_API_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Same app id exposed to the browser for Web Push enroll (optional).
NEXT_PUBLIC_ONESIGNAL_APP_ID=
# Zoho One / SalesIQ live chat widget code (Contact us opens chat like WeCasa→Intercom).
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=
# Optional override; defaults to EU SalesIQ widget host.
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_URL=https://salesiq.zoho.eu/widget
# Zoho CRM (EU) — server-only. Syncs customers→Contacts and cleaners→Leads.
# Create a self-client in Zoho API Console (EU) with scopes:
# ZohoCRM.modules.contacts.CREATE,ZohoCRM.modules.contacts.UPDATE,
# ZohoCRM.modules.leads.CREATE,ZohoCRM.modules.leads.UPDATE
# Generate a refresh token, then set these. Sync is skipped when unset.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Defaults match SalesIQ .eu; change only if your Zoho org is on another DC.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
ZOHO_API_DOMAIN=https://www.zohoapis.eu
# International number, digits only, used by the public WhatsApp button.
NEXT_PUBLIC_WHATSAPP_NUMBER=447490228111
# Server-only. Places API key for the live Mundoria Google reviews badge.
GOOGLE_PLACES_API_KEY=
# Optional. When empty, the site searches for Mundoria Uk, 32 High Street, Bromsgrove.
GOOGLE_PLACE_ID=
# Optional Mag social + newsletter (defaults to mundoriauk profiles if unset).
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mundoriauk
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/mundoriauk
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@mundoriauk
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/mundoriauk
# Optional POST endpoint for Mag newsletter subscribe JSON { email, source }.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
RESEND_API_KEY=
# Verified Resend domain sender for all Mundoria transactional mail
RESEND_FROM_EMAIL=Mundoria <hello@mundoria.co.uk>
# Shown in email footers / reply-to (use the same domain)
SUPPORT_EMAIL=hello@mundoria.co.uk
# Ops alerts (new signups, cleaner applications). Falls back to SUPPORT_EMAIL if empty.
ADMIN_NOTIFICATION_EMAIL=
CRON_SECRET=
# Commercial office hourly rate in pence (default 3500 = £35/hr) until rates are final.
COMMERCIAL_HOURLY_RATE_PENCE=3500
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Canonical site URL for SEO (sitemap, Open Graph, robots). Use www — apex redirects there.
NEXT_PUBLIC_APP_URL=https://www.mundoria.com
EMAIL_ASSET_BASE_URL=
# Analytics. The site always loads GTM-WB99DT5R. Consent Mode still gates tags.
NEXT_PUBLIC_GTM_ID=GTM-WB99DT5R
NEXT_PUBLIC_GA_MEASUREMENT_ID=
